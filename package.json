{
  "name": "dsh-tool-compact-context",
  "version": "0.4.0",
  "description": "Model-facing trigger for native context compaction and read-only context status for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMGateX/dsh-tool-compact-context.git"
  },
  "homepage": "https://github.com/LMGateX/dsh-tool-compact-context#readme",
  "bugs": {
    "url": "https://github.com/LMGateX/dsh-tool-compact-context/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/main.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-alpha.4 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
